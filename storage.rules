rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos - user can only write their own
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Attendance session images - institution scoped
    match /attendance/{institutionId}/{sessionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.institution_id == institutionId;
      allow delete: if request.auth != null
        && request.auth.token.institution_id == institutionId;
    }

    // Institution logos
    match /logos/{institutionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.institution_id == institutionId;
      allow delete: if request.auth != null
        && request.auth.token.institution_id == institutionId;
    }

    // Report exports - institution scoped read
    match /reports/{institutionId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.institution_id == institutionId;
      allow create: if request.auth != null
        && request.auth.token.institution_id == institutionId;
      allow delete: if request.auth != null
        && request.auth.token.institution_id == institutionId;
    }

    // Super admin global reports
    match /reports/global/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.role == 'super_admin';
      allow write: if request.auth != null
        && request.auth.token.role == 'super_admin';
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
