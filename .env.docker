# Attendrix Docker Environment Configuration
# Copy this file to .env and customize for your deployment

# Django Settings
DJANGO_SETTINGS_MODULE=attendrix.settings.production
DEBUG=False
SECRET_KEY=attendrix_super_secret_key_change_in_production_please_make_it_long_and_random

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=attendrix
DB_USER=attendrix
DB_PASSWORD=attendrix_secure_password_2024_change_me

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=redis_secure_password_2024_change_me
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Web Server Configuration
WEB_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@attendrix.com

# Security Configuration
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_FRAME_DENY=True
X_FRAME_OPTIONS=DENY

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/attendrix.log
SENTRY_DSN=your-sentry-dsn-here

# Monitoring Configuration
ENABLE_HEALTH_CHECKS=True
ENABLE_METRICS=True
METRICS_PORT=9090

# Celery Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_TIMEOUT=120
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Flower Configuration (Celery Monitoring)
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=flower_secure_password_2024_change_me

# Nginx Configuration
HTTP_PORT=80
HTTPS_PORT=443
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Database Admin Configuration
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@attendrix.com
PGADMIN_PASSWORD=admin123_change_me

# Redis Commander Configuration
REDIS_COMMANDER_PORT=8081

# Mailhog Configuration (Development Only)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# Superuser Configuration (for initial setup)
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@attendrix.com
SUPERUSER_PASSWORD=admin123_change_me

# Service Startup Flags
START_CELERY_WORKER=true
START_CELERY_BEAT=true
START_FLOWER=true

# Development Configuration (override with docker-compose.override.yml)
# DEBUG=True
# DJANGO_SETTINGS_MODULE=attendrix.settings.development
# EMAIL_HOST=mailhog
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False

# Production Configuration
# DEBUG=False
# DJANGO_SETTINGS_MODULE=attendrix.settings.production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True

# External API Configuration
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# GOOGLE_RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Third-party Integrations
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Performance Configuration
# ENABLE_CACHING=True
# CACHE_TIMEOUT=300
# ENABLE_COMPRESSION=True
# ENABLE_ETAGS=True

# Security Headers
# SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# Rate Limiting
# RATELIMIT_ENABLE=True
# RATELIMIT_USE_CACHE=True
# RATELIMIT_CACHE_NAME=ratelimit

# API Configuration
# API_THROTTLE_RATES={'default': '1000/hour', 'login': '5/minute'}
# API_VERSION=v1
# API_DOCS_ENABLED=True

# Feature Flags
# ENABLE_BETA_FEATURES=False
# ENABLE_ANALYTICS=True
# ENABLE_NOTIFICATIONS=True
# ENABLE_GAMIFICATION=True
# ENABLE_SURVEYS=True
# ENABLE_REPORTS=True

# Logging Levels (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DJANGO_LOG_LEVEL=INFO
# CELERY_LOG_LEVEL=INFO
# NGINX_LOG_LEVEL=warn
# POSTGRES_LOG_LEVEL=warning
# REDIS_LOG_LEVEL=notice
