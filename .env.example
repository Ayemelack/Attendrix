# ════════════════════════════════════════════════════════════════
# ATTENDRIX — Enterprise Paperless Attendance System
# Environment Configuration Template
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# PHASE 2 SECURITY HARDENING — All configuration variables
# ════════════════════════════════════════════════════════════════

# Environment (development / staging / production)
ENVIRONMENT=development

# ── Application URLs ──
APPLICATION_URL=https://attendrix.app
ADMIN_URL=https://admin.attendrix.app
API_URL=https://api.attendrix.app

# ── Firebase Configuration ──
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json
FIREBASE_PROJECT_ID=attendrix-system
FIREBASE_DATABASE_URL=https://attendrix-system.firebaseio.com
USE_MOCK_FIREBASE=true

# ── Database Configuration ──
DATABASE_URL=postgresql://user:password@localhost:5432/attendrix_prod
REDIS_URL=redis://localhost:6379/0

# ── Flask Configuration ──
# MINIMUM 32 characters, cryptographically random. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production
FLASK_DEBUG=False

# ── Email Configuration ──
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
MAIL_FROM=noreply@attendrix.app
MAIL_FROM_NAME=Attendrix

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@attendrix.app
RESEND_FROM_NAME=Attendrix
EMAIL_ENABLED=true

# ── Authentication & JWT ──
# MINIMUM 64 characters, cryptographically random. Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://attendrix.app,https://admin.attendrix.app,https://api.attendrix.app

# ── Rate Limiting ──
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_DEFAULT=200 per day, 50 per hour

# ── File Upload ──
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf,doc,docx

# ── Analytics & Monitoring ──
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Geolocation ──
GOOGLE_GEOCODING_API_KEY=
DEFAULT_GEOLOCATION_RADIUS=100  # meters

# ── Attendance Configuration ──
DEFAULT_ATTENDANCE_THRESHOLD=75  # percentage
SESSION_TIMEOUT_MINUTES=15
MAX_LATE_MINUTES=10

# ── Cache ──
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/2

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ════════════════════════════════════════════════════════════════
# PHASE 2 — ENTERPRISE SECURITY HARDENING
# ════════════════════════════════════════════════════════════════

## ── PHASE 2A: Production Environment Settings ──
# Set to 'production' to enable all security protections
FORCE_HTTPS=false
HSTS_ENABLED=true
CSP_ENABLED=true

## ── PHASE 2B: CAPTCHA ──
## Primary: Cloudflare Turnstile. Fallback: Google reCAPTCHA.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

## ── PHASE 2C: MFA/TOTP ──
## Roles that require MFA (comma-separated): super_admin, institutional_admin, lecturer
MFA_REQUIRED_FOR=super_admin,institutional_admin

## ── PHASE 2D: IP Intelligence ──
## MaxMind GeoIP2 database path (leave empty to disable)
GEOIP_ENABLED=false
GEOIP_DATABASE_PATH=
# AbuseIPDB API key for IP reputation checks
ABUSEIPDB_API_KEY=
# IPQualityScore API key
IPQUALITY_API_KEY=
# Network validation mode: 'mock' for development, 'real' for production
USE_MOCK_NETWORK=true

## ── PHASE 2E: Redis + Persistent Sessions ──
## Set to true to use Redis for persistent session/rate-limit storage
REDIS_SESSION_ENABLED=false
PERSISTENT_RATE_LIMIT=false

## ── PHASE 2F: Geolocation + Device Trust ──
## Enforce geolocation validation for attendance
GEOLOCATION_ENFORCED=false
## Enable device trust scoring and history
DEVICE_TRUST_ENABLED=false

## ── PHASE 2G: Email Production Readiness ──
## SPF domain for email authentication (e.g., attendrix.app)
SPF_DOMAIN=
## Enable DKIM signing for outgoing emails
DKIM_ENABLED=false
## DMARC policy: none, quarantine, reject
DMARC_POLICY=none
## Email for security alerts
SECURITY_ALERT_EMAIL=

## ── PHASE 2H: Security Monitoring ──
## Enable centralized security event monitoring
SECURITY_MONITORING_ENABLED=false
## Webhook URL for security alerts (Slack, Teams, etc.)
SECURITY_ALERT_WEBHOOK=

## ── Password Policy ──
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=True
PASSWORD_REQUIRE_LOWER=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_SIZE=5
PASSWORD_LOCKOUT_THRESHOLD=5
PASSWORD_LOCKOUT_MINUTES=15

## ── CSRF Protection ──
CSRF_TOKEN_EXPIRY=3600
CSRF_TOKEN_BYTES=32

## ── Rate Limiting (Enhanced) ──
RATE_LIMIT_WINDOW=60
RATE_LIMIT_IP_THRESHOLD=100
RATE_LIMIT_LOGIN_THRESHOLD=5
RATE_LIMIT_REGISTER_THRESHOLD=3
RATE_LIMIT_BLOCK_DURATION=300

## ── Session Security ──
SESSION_COOKIE_NAME=attendrix_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERSISTENT_SESSION_TTL=86400

## ── Password Reset ──
PASSWORD_RESET_EXPIRY=3600

## ── Security Headers ──
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=True

## ── Content Security Policy ──
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com
CSP_STYLE_SRC='self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com
CSP_FONT_SRC='self' https://cdnjs.cloudflare.com https://fonts.gstatic.com https://fonts.googleapis.com
CSP_IMG_SRC='self' data: blob: https:

## ── Audit Logging ──
AUDIT_LOG_ENABLED=True
AUDIT_LOG_RETENTION_DAYS=365

## ── IP Blocklist (comma-separated CIDR or IPs) ──
IP_BLOCKLIST=

# ════════════════════════════════════════════════════════════════
# CLOUDFLARE SECURITY CONFIGURATION
# ════════════════════════════════════════════════════════════════

## ── Cloudflare Turnstile ──
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

## ── Cloudflare API (for programmatic WAF management) ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

## ── Zero Trust ──
CLOUDFLARE_ACCESS_TEAM_NAME=
CLOUDFLARE_ACCESS_AUDIENCE_TAG=

## ── Bot Management ──
CLOUDFLARE_BOT_SCORE_THRESHOLD=30
CLOUDFLARE_CHALLENGE_PASSED_TTL=1800

## ── Security Level ──
CLOUDFLARE_SECURITY_LEVEL=high
CLOUDFLARE_CHALLENGE_TTL=1800

# ════════════════════════════════════════════════════════════════
# DEMO & ONBOARDING
# ════════════════════════════════════════════════════════════════

DEMO_SESSION_EXPIRY_MINUTES=60
DEMO_BOOKING_WINDOW_DAYS=30
DEMO_TRIAL_DURATION_DAYS=14
BOOTSTRAP_ADMIN_PASSWORD=D3f@ultCh4ng3Me!
