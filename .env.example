# Attendrix Environment Configuration
# Copy this file to .env and update the values

# Django Settings
SECRET_KEY=your-super-secret-key-change-me-in-production
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DB_NAME=attendrix_dev
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Staging Database (override for staging)
STAGING_DB_NAME=attendrix_staging
STAGING_DB_USER=postgres
STAGING_DB_PASSWORD=staging-password
STAGING_DB_HOST=localhost
STAGING_DB_PORT=5432

# Production Database (override for production)
PROD_DB_NAME=attendrix_prod
PROD_DB_USER=postgres
PROD_DB_PASSWORD=production-password
PROD_DB_HOST=localhost
PROD_DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1
STAGING_REDIS_URL=redis://127.0.0.1:6379/1
PROD_REDIS_URL=redis://127.0.0.1:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@attendrix.com

# Production Email (override for production)
PROD_EMAIL_HOST=smtp.gmail.com
PROD_EMAIL_PORT=587
PROD_EMAIL_USE_TLS=True
PROD_EMAIL_HOST_USER=your-production-email@gmail.com
PROD_EMAIL_HOST_PASSWORD=your-production-app-password
PROD_DEFAULT_FROM_EMAIL=noreply@attendrix.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STAGING_CORS_ORIGINS=https://staging.attendrix.com,http://localhost:3000
PROD_CORS_ORIGINS=https://attendrix.com,https://www.attendrix.com

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1
STAGING_ALLOWED_HOSTS=staging.attendrix.com,localhost,127.0.0.1
PROD_ALLOWED_HOSTS=attendrix.com,www.attendrix.com

# Feature Flags
ENABLE_GEOLOCATION=True
ENABLE_DEVICE_FINGERPRINTING=True
ENABLE_PREDICTIVE_ANALYTICS=True
ENABLE_GAMIFICATION=True

# Analytics and Monitoring
ENABLE_ANALYTICS=True
SENTRY_DSN=

# API Rate Limiting
API_RATE_LIMIT=1000/hour
API_RATE_LIMIT_ANON=100/hour

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT_MINUTES=30
PASSWORD_RESET_TIMEOUT_HOURS=24
SESSION_TIMEOUT_MINUTES=60

# Business Logic
DEFAULT_ATTENDANCE_THRESHOLD=75
MAX_SESSION_DURATION_MINUTES=120
LATE_ARRIVAL_GRACE_MINUTES=15
MAX_LEAVE_REQUEST_DAYS=30
AUTO_APPROVE_LEAVE_DAYS=1

# File Upload Limits (in bytes)
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
UPLOAD_FILE_MAX_SIZE=5242880
